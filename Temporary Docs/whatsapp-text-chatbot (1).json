        }
      },
      "id": "dddddddd-dddd-dddd-dddd-dddddddddddd",
      "name": "ACK Meta",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [420, 380]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json;\nconst entry = body?.entry?.[0];\nconst change = entry?.changes?.[0];\nconst msg = change?.value?.messages?.[0];\n\nif (!msg || msg.type !== 'text') return [];\n\nreturn [{ json: {\n  phone: msg.from,\n  text: msg.text.body.trim(),\n  waId: change.value.metadata.phone_number_id\n}}];"
      },
      "id": "eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee",
      "name": "Extract Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [640, 380]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=AIzaSyAqH9TGPcj2Dm4JilKs1u1GQ1I9v_6hyNc",
        "sendBody": true,
        "bodyParameters": { "parameters": [] },
        "jsonBody": "={\"system_instruction\":{\"parts\":[{\"text\":\"You are a helpful friendly WhatsApp assistant. Keep replies short and conversational. Plain text only, no asterisks or markdown.\"}]},\"contents\":[{\"role\":\"user\",\"parts\":[{\"text\":\"{{$json[\\\"text\"]}}\"}]}],\"generationConfig\":{\"temperature\":0.7,\"maxOutputTokens\":400}}",
        "options": {}
      },
      "id": "ffffffff-ffff-ffff-ffff-ffffffffffff",
      "name": "Call Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [860, 380]
    },
    {
      "parameters": {
        "jsCode": "const reply = $json?.candidates?.[0]?.content?.parts?.[0]?.text || 'Sorry, try again.';\nconst prev = $('Extract Message').first().json;\nreturn [{ json: { phone: prev.phone, waId: prev.waId, reply: reply.trim() } }];"
      },
      "id": "22222222-2222-2222-2222-222222222222",
      "name": "Extract Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [1080, 380]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/1072858022582097/messages",
        "sendHeaders": true,
